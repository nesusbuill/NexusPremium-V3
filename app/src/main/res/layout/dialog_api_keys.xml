<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dán từ 1-3 key Groq (mỗi dòng 1 key).\nCó nhiều key → tự động xoay khi hết quota.\n\n🔗 Lấy key: console.groq.com/keys"
            android:textColor="#88FFFFFF"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"
            android:paddingBottom="12dp" />

        <EditText
            android:id="@+id/etKey1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Key 1 (gsk_...)"
            android:inputType="text"
            android:padding="12dp"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:textColorHint="#66FFFFFF"
            android:background="#1AFFFFFF"
            android:layout_marginBottom="8dp"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/etKey2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Key 2 (gsk_... - tùy chọn)"
            android:inputType="text"
            android:padding="12dp"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:textColorHint="#66FFFFFF"
            android:background="#1AFFFFFF"
            android:layout_marginBottom="8dp"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/etKey3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Key 3 (gsk_... - tùy chọn)"
            android:inputType="text"
            android:padding="12dp"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:textColorHint="#66FFFFFF"
            android:background="#1AFFFFFF"
            android:importantForAutofill="no" />

    </LinearLayout>
</ScrollView>
